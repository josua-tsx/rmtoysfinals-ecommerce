<html>
  <head>
    <style>
      body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
      .invoice-box { max-width: 800px; margin: auto; padding: 30px; } .header {
      text-align: center; margin-bottom: 20px; } .content { margin-top: 40px; }
    </style>
  </head>
  <body>
    <div class="invoice-box">
      <div class="header">
        <h1>Invoice for {{invoice.customerName}}</h1>
      </div>
      <div class="content">
        <p><strong>Invoice ID:</strong> {{invoice.mahalko}}</p>
        <p><strong>Date:</strong> {{invoice.mahalkaba}}</p>
        <p><strong>Amount Due:</strong> ${{invoice.haha}}</p>
        <hr />
        <p>Thank you for your business!</p>
      </div>
    </div>
  </body>
</html>

